# Environment variables (names only — never commit real values)
#
# Copy to .env and fill in values locally. In production each host
# provides these via its own secrets management.

# --- Backend (API server) ---
# Supabase Postgres connection string used by the app and Drizzle.
SUPABASE_DATABASE_URL=
# Clerk authentication (server side)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Comma-separated allowlists for platform admins (emails or Clerk user IDs)
PLATFORM_ADMIN_EMAILS=
PLATFORM_ADMIN_USER_IDS=
# App runtime
PORT=
BASE_PATH=
NODE_ENV=
LOG_LEVEL=
SESSION_SECRET=

# --- Frontend (Vite, embedded at build time) ---
# Origin of the API server, no trailing slash or /api suffix
VITE_API_URL=
# Clerk publishable key
VITE_CLERK_PUBLISHABLE_KEY=
# Optional Clerk proxy URL
VITE_CLERK_PROXY_URL=

# --- Optional integrations ---
EIA_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
